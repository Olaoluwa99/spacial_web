---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import StyleArt from '../../components/StyleArt.astro';
import { styles, releaseFor, displaySize, type Style } from '../../data/styles';
export function getStaticPaths() { return styles.map(style => ({ params: { id: style.id }, props: { style } })); }
const { style } = Astro.props as { style: Style };
const release = releaseFor(style.id);
const next = styles[(styles.findIndex(s => s.id === style.id) + 1) % styles.length];
---
<Base title={`${style.name} — Special`} description={`${style.description} Explore the live showcase and download the ${style.name} design bundle.`}>
<div class="container detail-breadcrumb"><a href="/styles/">The collection</a><span>/</span><span>{style.name}</span></div>
<section class="container detail-hero"><div><span class="eyebrow">STYLE {style.number} / {style.category.toUpperCase()}</span><h1>{style.name}<span>.</span></h1><p class="detail-tagline">{style.tagline}</p><p class="detail-description">{style.description}</p><div class="detail-actions"><a href={release.download} download class="button">Get the bundle <Icon name="download"/></a><a href="#live-showcase" class="text-link">See it move <Icon name="play" size={17}/></a></div><div class="release-note">VERSION {release.version}<span>·</span>{displaySize(release.bytes)}<span>·</span>WEB + COMPOSE</div></div><div class="detail-visual"><StyleArt id={style.id}/><span class="detail-mood">{style.mood}</span></div></section>
<section id="live-showcase" class="showcase-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">01 / SEE IT IN ACTION</span><h2>A screen worth<br/>spending time with.</h2></div><p>Interact with the original showcase.<br/>Every control is part of the design language.</p></div><div class="demo-studio" data-demo-studio><div class="demo-studio-toolbar"><div class="demo-sizes" aria-label="Showcase width"><button data-demo-size="phone" aria-pressed="true">Phone</button><button data-demo-size="wide" aria-pressed="false">Wide</button></div><span class="demo-studio-caption">{style.name} / LIVE SHOWCASE</span><a href={release.demo} target="_blank" rel="noopener">Open full screen <span>↗</span></a></div><div class="demo-studio-canvas"><div class="demo-device" data-demo-device><iframe src={release.demo} title={`${style.name} interactive showcase`} loading="lazy" sandbox="allow-scripts allow-same-origin"></iframe></div></div><div class="demo-studio-bottom"><span><i class="status-dot"></i> REAL CODE. REAL INTERACTIONS.</span><span>Respects your device’s motion preference.</span></div></div></div></section>
<section class="section container anatomy-section"><div class="section-heading"><div><span class="eyebrow">02 / THE DESIGN LANGUAGE</span><h2>What makes it<br/>{style.short.toLowerCase()}.</h2></div><p>{style.suited}</p></div><div class="anatomy-grid">{style.anatomy.map((item, i) => <div><span class="eyebrow">0{i + 1}</span><h3>{item}</h3></div>)}</div><div class="style-notes"><div><span class="eyebrow">THE RHYTHM</span><h3>{style.motion}</h3><a href="/playground/" class="text-link">Explore spring motion <Icon name="arrow" size={17}/></a></div><div><span class="eyebrow">KEEP THE FEELING</span><ul>{style.rules.map(rule => <li><Icon name="check" size={17}/>{rule}</li>)}</ul></div></div></section>
<section class="download-section container"><div><span class="eyebrow">03 / YOUR NEXT PROJECT STARTS HERE</span><h2>Take {style.short.toLowerCase()}<br/>with you.</h2><p>Exact tokens. Thoughtful motion. Ready-to-use components.<br/>The complete design language in one download.</p><a href={release.download} download class="button button-lime">Download v{release.version} <Icon name="download"/></a><a class="download-guide" href="/guide/">First bundle? Start here ↗</a></div><div class="download-contents"><div><span>Design language & component recipes</span><Icon name="check" size={18}/></div><div><span>Colour, type, spacing & motion tokens</span><Icon name="check" size={18}/></div><div><span>Web CSS, React components & live example</span><Icon name="check" size={18}/></div><div><span>Jetpack Compose components</span><Icon name="check" size={18}/></div><div><span>Reference image & quality checklist</span><Icon name="check" size={18}/></div><small>{displaySize(release.bytes)} ZIP · No account required</small><details><summary>Verify your download</summary><p>SHA-256</p><code>{release.sha256}</code></details></div></section>
<a href={`/styles/${next.id}/`} class="next-style container"><span><small class="eyebrow">NEXT IN THE COLLECTION</small><strong>{next.name}</strong></span><Icon name="arrow" size={35}/></a>
</Base>
