---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import StyleArt from '../components/StyleArt.astro';
import StyleCard from '../components/StyleCard.astro';
import { styles } from '../data/styles';
---
<Base>
<section class="hero container">
  <div class="hero-copy"><div class="eyebrow hero-eyebrow"><span class="status-dot"></span> A COLLECTION OF EXTRAORDINARY INTERFACES</div><h1>Make it<br/>feel <span class="hero-special">special<span class="title-star" aria-hidden="true">✳</span>.</span></h1><p class="hero-description">Good interfaces work.<br/>Great ones make you <em>feel something.</em></p><p class="hero-support">Explore the styles. Understand the motion.<br/>Take the whole design system into your next project.</p><div class="hero-actions"><a href="#collection" class="button">Explore the collection <Icon name="arrow"/></a><a href="/guide/" class="text-link">Meet Special <span>↗</span></a></div><div class="hero-footnote"><span class="mini-line"></span> SIX STYLES. ENDLESS POSSIBILITIES.</div></div>
  <div class="hero-showcase" data-hero-showcase><div class="showcase-grid" aria-hidden="true"></div><div class="showcase-orbit" aria-hidden="true"></div><span class="showcase-caption eyebrow">A FEELING. NOT JUST A FRAME.</span><div class="hero-main-art"><StyleArt id="glassmorphism"/></div><div class="hero-kinetic-fragment" aria-hidden="true"><small>WORDS THAT MOVE</small><strong>TYPE<br/>WITH<br/><span>FEELING.</span></strong><span class="fragment-star">✳</span></div><div class="hero-clay-fragment" aria-hidden="true"><i></i><span>Good energy.</span><div><b>✳</b><b>♪</b><b>☾</b></div></div><div class="floating-label"><span class="status-dot"></span> DESIGNED TO COME ALIVE</div><div class="hero-art-caption"><span>01 — GLASSMORPHISM</span><button data-preview="glassmorphism" aria-label="Open Glassmorphism live preview"><Icon name="play" size={15}/> Try it live</button></div></div>
</section>
<div class="principle-strip"><div class="container"><span>NOT ANOTHER UI KIT.</span><span>REAL SURFACES <i aria-hidden="true">✳</i> REAL MOTION <i aria-hidden="true">✳</i> REAL CODE <i aria-hidden="true">✳</i> YOUR NEXT IDEA</span></div></div>
<section id="collection" class="section container collection-section"><div class="section-heading"><div><span class="eyebrow">01 / THE COLLECTION</span><h2>Six ways to<br/>make an impression.</h2></div><p>Every style is its own little world.<br/>Find the one that feels like yours.</p></div><div class="collection-toolbar"><div class="filter-group" aria-label="Filter styles">{['All styles','Surfaces','Typography','Layout'].map((filter, i) => <button data-filter={filter} aria-pressed={i === 0}>{filter}{i === 0 && <span>06</span>}</button>)}</div><span class="collection-count" aria-live="polite" data-collection-count>06 styles to explore</span></div><div class="style-grid">{styles.map(style => <StyleCard style={style}/>)}</div><div class="collection-note"><span class="status-dot"></span><p>Every style includes a live showcase, motion recipes and ready-to-use code.</p><a href="/guide/">What’s in a bundle? <Icon name="arrow" size={17}/></a></div></section>
<section class="craft-section"><div class="container craft-grid"><div class="craft-copy"><span class="eyebrow">02 / BEYOND THE SCREENSHOT</span><h2>A look is a start.<br/><em>A feeling</em> is<br/>the whole point.</h2><p>It’s the way a card settles. How a button gives back. The space a grid makes for something new.</p><p>Special puts the surfaces, the rules and the motion in your hands—so you can make something that feels considered from the first frame to the last.</p><a class="button button-light" href="/playground/">Find your rhythm <Icon name="arrow"/></a></div><div class="motion-exhibit" data-motion-exhibit><div class="exhibit-top"><span class="eyebrow">A LITTLE MOTION. A LOT OF CHARACTER.</span><span>INTERACTIVE ↗</span></div><div class="motion-track"><div class="motion-track-line"></div><div class="motion-cube" data-motion-cube><Mark size={50}/></div><div class="track-end">＋</div></div><div class="motion-presets" aria-label="Motion character"><button data-motion-preset="calm" aria-pressed="true">Calm</button><button data-motion-preset="playful" aria-pressed="false">Playful</button><button data-motion-preset="snappy" aria-pressed="false">Snappy</button></div><div class="exhibit-bottom"><p data-motion-description>A gentle arrival. A quiet confidence.</p><button class="motion-replay" data-motion-replay>Replay <span>↻</span></button></div></div></div></section>
<section class="section container bundle-section"><div class="section-heading"><div><span class="eyebrow">03 / MAKE IT YOURS</span><h2>From “I love that”<br/>to “I made this.”</h2></div><p>Everything that makes a style special.<br/>Packaged for your next project.</p></div><div class="bundle-grid"><div class="bundle-file-visual"><div class="file-window"><div class="file-window-head"><Mark size={19}/><span>YOUR NEXT DESIGN SYSTEM</span><span>↗</span></div><div class="file-row"><span class="file-symbol">✳</span><div><strong>The design language</strong><small>Principles, components & things to avoid</small></div><span>01</span></div><div class="file-row"><span class="file-symbol">{ }</span><div><strong>The exact details</strong><small>Colour, spacing, type & motion tokens</small></div><span>02</span></div><div class="file-row"><span class="file-symbol">↗</span><div><strong>A head start</strong><small>Web, Compose & a working showcase</small></div><span>03</span></div><div class="file-window-foot"><span>ONE BUNDLE. THE WHOLE PICTURE.</span><Icon name="download" size={20}/></div></div><div class="bundle-stamp">MADE<br/>TO BE<br/>USED <span>✳</span></div></div><div class="bundle-steps"><div><span class="step-index">01</span><h3>Find your feeling.</h3><p>Play with a live showcase. See the style in action before choosing a direction.</p></div><div><span class="step-index">02</span><h3>Take the whole system.</h3><p>Download its bundle: the design language, exact tokens, motion recipes and code.</p></div><div><span class="step-index">03</span><h3>Make something of your own.</h3><p>Use the components directly or give the bundle to your coding assistant. Start with intent.</p></div><a href="/guide/" class="text-link">The getting-started guide <Icon name="arrow" size={18}/></a></div></div></section>
<section class="final-cta container"><div><span class="eyebrow">YOUR NEXT IDEA DESERVES A LITTLE MORE.</span><h2>Make something<br/><em>worth feeling.</em></h2></div><a href="/styles/" class="cta-circle" aria-label="Explore all six styles"><Icon name="arrow" size={40}/></a><Mark size={150}/></section>
</Base>
