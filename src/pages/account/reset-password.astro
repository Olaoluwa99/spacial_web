---
import AccountShell from '../../components/AccountShell.astro';
import Icon from '../../components/Icon.astro';
---
<AccountShell title="A new password — Special" eyebrow="02 / A FRESH START" heading="Fresh start." emphasis="Same good taste." description="Choose a new password, then get back to the styles and ideas you’ve made your own.">
  <h2>A new password<span>.</span></h2>
  <p class="account-form-intro">Use the reset link from your email to update your password here.</p>
  <form method="post" class="account-form" data-auth-form="reset">
    <label for="reset-password">New password<input id="reset-password" name="password" type="password" autocomplete="new-password" required minlength="12" aria-describedby="reset-guidance"/><span class="account-field-note" id="reset-guidance">Use at least 12 characters, with a password you haven’t used elsewhere.</span></label>
    <p class="account-status" data-auth-status role="status" aria-live="polite"></p>
    <button class="button account-submit" type="submit">Save new password <Icon name="arrow"/></button>
  </form>
  <p class="account-switch"><a href="/account/forgot-password/">Need a new reset link? <Icon name="arrow" size={14}/></a></p>
</AccountShell>
