---
import AccountShell from '../../components/AccountShell.astro';
import Icon from '../../components/Icon.astro';
---
<AccountShell title="Reset your password — Special" eyebrow="02 / A FRESH START" heading="Back to" emphasis="good things." description="A moment away doesn’t have to mean starting over. Find your way back to your personal collection.">
  <h2>Let’s get you back in<span>.</span></h2>
  <p class="account-form-intro">Enter your email and we’ll send a password reset link.</p>
  <form method="post" class="account-form" data-auth-form="forgot">
    <label for="forgot-email">Email address<input id="forgot-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254"/></label>
    <p class="account-status" data-auth-status role="status" aria-live="polite"></p>
    <button class="button account-submit" type="submit">Send reset link <Icon name="arrow"/></button>
  </form>
  <p class="account-switch"><a href="/account/sign-in/" data-account-next-link>Back to sign in <Icon name="arrow" size={14}/></a></p>
</AccountShell>
